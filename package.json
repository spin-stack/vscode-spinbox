{
  "name": "spinbox",
  "displayName": "Spinbox",
  "description": "Open Spinbox workspaces in VS Code over Remote-SSH, through the spin CLI.",
  "version": "0.0.5",
  "publisher": "spin-stack",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#111827",
    "theme": "dark"
  },
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/spin-stack/vscode-spinbox"
  },
  "homepage": "https://github.com/spin-stack/vscode-spinbox#readme",
  "bugs": {
    "url": "https://github.com/spin-stack/vscode-spinbox/issues"
  },
  "packageManager": "pnpm@11.27.1",
  "engines": {
    "vscode": "^1.146.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "spinbox",
    "spin",
    "remote",
    "remote-ssh",
    "ssh",
    "remote development",
    "cloud development environment",
    "cde",
    "dev environment",
    "workspace",
    "sandbox",
    "virtual machine",
    "vm",
    "self-hosted",
    "ai agents"
  ],
  "extensionKind": [
    "ui"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onResolveRemoteAuthority:ssh-remote",
    "onUri",
    "onCommand:spinbox.openWorkspace",
    "onCommand:spinbox.signIn",
    "onCommand:spinbox.signOut",
    "onAuthenticationRequest:spinbox",
    "onCommand:spinbox.refresh",
    "onCommand:spinbox.startWorkspace",
    "onCommand:spinbox.stopWorkspace",
    "onCommand:spinbox.workspaceMenu"
  ],
  "contributes": {
    "commands": [
      {
        "command": "spinbox.openWorkspace",
        "title": "Open Workspace",
        "category": "Spinbox",
        "icon": "$(link-external)"
      },
      {
        "command": "spinbox.signIn",
        "title": "Sign In",
        "category": "Spinbox"
      },
      {
        "command": "spinbox.signOut",
        "title": "Sign Out",
        "category": "Spinbox"
      },
      {
        "command": "spinbox.refresh",
        "title": "Refresh Workspaces",
        "category": "Spinbox",
        "icon": "$(refresh)"
      },
      {
        "command": "spinbox.startWorkspace",
        "title": "Start Workspace",
        "category": "Spinbox",
        "icon": "$(debug-start)"
      },
      {
        "command": "spinbox.stopWorkspace",
        "title": "Stop Workspace",
        "category": "Spinbox",
        "icon": "$(debug-stop)"
      },
      {
        "command": "spinbox.workspaceMenu",
        "title": "Workspace Actions",
        "category": "Spinbox"
      }
    ],
    "authentication": [
      {
        "id": "spinbox",
        "label": "Spinbox"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "spinbox.workspaces",
          "name": "Spinbox Workspaces"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "spinbox.workspaces",
        "contents": "Sign in to Spinbox to see your workspaces.\n[Sign In](command:spinbox.workspaces.signIn)",
        "when": "spinbox.workspaces == signedOut"
      },
      {
        "view": "spinbox.workspaces",
        "contents": "You have no Spinbox workspaces.",
        "when": "spinbox.workspaces == listed"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "spinbox.startWorkspace",
          "when": "false"
        },
        {
          "command": "spinbox.stopWorkspace",
          "when": "false"
        },
        {
          "command": "spinbox.workspaceMenu",
          "when": "spinbox.inWorkspace"
        }
      ],
      "view/title": [
        {
          "command": "spinbox.refresh",
          "when": "view == spinbox.workspaces",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "spinbox.openWorkspace",
          "when": "view == spinbox.workspaces && viewItem =~ /^workspace\\b/",
          "group": "inline@1"
        },
        {
          "command": "spinbox.startWorkspace",
          "when": "view == spinbox.workspaces && viewItem =~ /\\bstartable\\b/",
          "group": "inline@2"
        },
        {
          "command": "spinbox.stopWorkspace",
          "when": "view == spinbox.workspaces && viewItem =~ /\\bstoppable\\b/",
          "group": "inline@3"
        },
        {
          "command": "spinbox.openWorkspace",
          "when": "view == spinbox.workspaces && viewItem =~ /^workspace\\b/",
          "group": "navigation@1"
        },
        {
          "command": "spinbox.startWorkspace",
          "when": "view == spinbox.workspaces && viewItem =~ /\\bstartable\\b/",
          "group": "navigation@2"
        },
        {
          "command": "spinbox.stopWorkspace",
          "when": "view == spinbox.workspaces && viewItem =~ /\\bstoppable\\b/",
          "group": "navigation@3"
        },
        {
          "command": "spinbox.refresh",
          "when": "view == spinbox.workspaces",
          "group": "navigation@4"
        }
      ]
    },
    "configuration": {
      "title": "Spinbox",
      "properties": {
        "spinbox.telemetry": {
          "type": "boolean",
          "default": true,
          "description": "Run each Spinbox operation in a trace the spin CLI joins, so the installation keeps it with its own. Off, the CLI is handed no trace; it still traces its own commands unless its profile sets telemetry: false."
        },
        "spinbox.cliPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "The spin CLI to run. Empty runs the one the extension carries."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:cli": "vitest run --config vitest.cli.config.mts",
    "test:integration": "node esbuild.mjs --tests && node test/integration/run.mjs",
    "package": "vsce package --no-dependencies --out spinbox.vsix"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "22.20.5",
    "@types/vscode": "1.146.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
